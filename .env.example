# 复制为 .env 并填入真实值。切勿把真实密钥提交进仓库。
# agent-compose daemon 通过 /data/work/.env 读取 LLM 配置（作为环境变量挂载）。

# LLM 提供方：OpenAI 兼容 chat_completions 协议
LLM_API_PROTOCOL=chat_completions
LLM_API_ENDPOINT=https://api.deepseek.com
# LLM_API_MODEL 在 agent-compose.yml 的 agent.model 中指定，或改为对应键
LLM_API_KEY=sk-your-deepseek-key-here