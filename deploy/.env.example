# 部署环境变量模板（对应 deploy/docker-compose.yml）
# 复制为 .env 并填入真实值。切勿把真实密钥提交进仓库。
# 本仓库 .gitignore 已忽略 .env，真实值只存在于部署服务器的 /opt/agent-compose/.env。

# --- 镜像版本 ---
AGENT_COMPOSE_IMAGE=chaitin/agent-compose:latest
DEFAULT_IMAGE=chaitin/agent-compose-guest:latest
AGENT_COMPOSE_FRONTEND_IMAGE=chaitin/agent-compose-ui:latest
AGENT_COMPOSE_HTTP_PORT=80
AGENT_COMPOSE_DATA_DIR=./data
AGENT_COMPOSE_UI_DATA_DIR=./data/agent-compose-ui

# --- UI（默认关闭；启用请设 COMPOSE_PROFILES=with-ui 并配置强口令）---
COMPOSE_PROFILES=
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_SECRET=change-me
AUTH_SESSION_TTL=24h

# --- daemon（仅绑定 127.0.0.1，不对公网开放）---
HTTP_LISTEN=0.0.0.0:7410
AGENT_COMPOSE_AUTH_TOKEN=
DATA_ROOT=/data
RUNTIME_DRIVER=docker

# --- LLM（DeepSeek，OpenAI 兼容 chat_completions）---
LLM_API_ENDPOINT=https://api.deepseek.com
LLM_API_PROTOCOL=chat_completions
LLM_API_KEY=sk-your-deepseek-key-here
LLM_MODEL=deepseek-chat
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT=120s